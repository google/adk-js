      {
        "path": ["status"],
        "example_adk_js_value": "UNSET",
        "example_adk_python_value": "ERROR",
        "reason": "adk-js turns a failed model call into an error event and a failed tool call into an error response, so the error does not reach the agent or the runner. The generate_content and execute_tool spans that failed still have status ERROR."
      }
    ]
  },
