    "divergences": [
      {
        "path": ["name"],
        "example_adk_js_value": "compact_events auto",
        "example_adk_python_value": "compact_events token_threshold",
        "reason": "The trigger is the adk-js compaction trigger (auto, manual or agent_controlled). adk-js has no token_threshold or sliding_window trigger value."
      },
      {
        "path": ["attributes", "gen_ai.compaction.trigger"],
        "example_adk_js_value": "auto",
        "example_adk_python_value": "token_threshold",
        "reason": "Same cause as the span name."
      },
      {
        "path": ["attributes", "gen_ai.compaction.event_count"],
        "example_adk_js_value": 6,
        "example_adk_python_value": 7,
        "reason": "The adk-js scenario keeps the last event (eventRetentionSize 1), where the Python one keeps none, so one fewer event is compacted."
      },
      {
        "path": ["attributes", "gen_ai.compaction.token_threshold"],
        "example_adk_js_value": {"missing_on_this_side": true},
        "example_adk_python_value": 300,
        "reason": "adk-js compactors keep their configuration private, so telemetry cannot read it."
      },
      {
        "path": ["attributes", "gen_ai.compaction.event_retention_size"],
        "example_adk_js_value": {"missing_on_this_side": true},
        "example_adk_python_value": 0,
        "reason": "adk-js compactors keep their configuration private, so telemetry cannot read it."
      },
      {
        "path": ["attributes", "gen_ai.compaction.summarizer_type"],
        "example_adk_js_value": {"missing_on_this_side": true},
        "example_adk_python_value": "LlmEventSummarizer",
        "reason": "adk-js compactors keep their summarizer private, so telemetry cannot read it."
      },
      {
        "path": ["attributes", "gen_ai.compaction.prompt_chars_saved"],
        "example_adk_js_value": {"missing_on_this_side": true},
        "example_adk_python_value": 253,
        "reason": "Computing it needs the request contents before and after compaction, which only the content processors build."
      }
    ]
  },
