      {
        "path": ["attributes", "gen_ai.system_instructions", "content"],
        "example_adk_js_value": "You are an agent. Your internal name is \"some_root_agent\".\n\nThe description about you is \"A sample root agent.\"\n\nyou are helpful",
        "example_adk_python_value": "you are helpful\n\nYou are an agent. Your internal name is \"some_root_agent\". The description about you is \"A sample root agent.\".",
        "reason": "The adk-js request processors compose the system instruction in a different order and wording. Telemetry records the instruction the model was sent."
      },
      {
        "path": ["attributes", "gen_ai.tool.definitions", "parameters"],
        "example_adk_js_value": {
          "properties": {"arg1": {"type": "STRING"}},
          "required": ["arg1"],
          "type": "OBJECT"
        },
        "example_adk_python_value": {
          "properties": {"arg1": {"title": "Arg1", "type": "string"}},
          "required": ["arg1"],
          "title": "some_toolParams",
          "type": "object"
        },
        "reason": "adk-js function tools declare their parameters as a Gemini Schema with upper-case types and no titles. Telemetry records the declaration the model was sent."
      }
    ]
  },
