  {
    "owner_type": "span",
    "owner_name": "invoke_agent some_root_agent",
    "affected_tests": [
      "agent/tool-error-valueerror",
      "agent/tool-error-valueerror-span-only"
    ],
    "divergences": [
      {
        "path": ["status"],
        "example_adk_js_value": "UNSET",
        "example_adk_python_value": "ERROR",
        "reason": "adk-js answers a tool that throws with an error response and continues the turn, so no error leaves the agent. The extra generate_content span after the tool span has the same cause."
      },
      {
        "path": ["children", "generate_content gemini-2.5-flash"],
        "example_adk_js_value": "a second generate_content span after execute_tool",
        "example_adk_python_value": {"missing_on_this_side": true},
        "reason": "adk-js sends the tool's error response back to the model, which makes a second model call."
      }
    ]
  },
  {
    "owner_type": "span",
