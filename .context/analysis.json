{
  "repository": {
    "name": "adk-js",
    "fullName": "Google Agent Development Kit for JavaScript/TypeScript",
    "description": "A comprehensive framework for building agentic AI applications with Google's Gemini API, featuring modular architecture, MCP protocol support, and advanced agent orchestration patterns.",
    "url": "https://github.com/google/adk-js",
    "license": "Apache-2.0"
  },
  "language": {
    "primary": "TypeScript",
    "version": "^5.9.2",
    "target": "ES2020",
    "moduleSystem": {
      "esm": true,
      "cjs": true
    },
    "packageManager": "npm workspaces",
    "workspaces": [
      {
        "name": "@google/adk",
        "type": "core",
        "version": "0.3.0"
      },
      {
        "name": "@google/adk-devtools",
        "type": "dev"
      }
    ]
  },
  "architecture": {
    "buildSystem": {
      "bundler": "esbuild",
      "typeGeneration": "tsc --emitDeclarationOnly"
    },
    "testFramework": "vitest ^3.2.4",
    "coreModules": [
      "agents",
      "tools",
      "models",
      "sessions",
      "events",
      "runner",
      "plugins",
      "artifacts",
      "memory",
      "auth",
      "code_executors",
      "examples",
      "telemetry",
      "utils"
    ],
    "hierarchies": {
      "agents": {
        "base": "BaseAgent",
        "implementations": [
          "LlmAgent",
          "LoopAgent",
          "SequentialAgent",
          "ParallelAgent"
        ]
      },
      "tools": {
        "base": "BaseTool",
        "implementations": [
          "FunctionTool",
          "AgentTool",
          "GoogleSearchTool",
          "MCPTool"
        ],
        "toolsets": {
          "base": "BaseToolset",
          "implementations": [
            "MCPToolset"
          ]
        }
      },
      "models": {
        "base": "BaseLlm",
        "implementations": [
          "Gemini",
          "Apigee"
        ]
      },
      "context": {
        "base": "ReadonlyContext",
        "implementations": [
          "CallbackContext",
          "ToolContext"
        ]
      }
    },
    "designPatterns": [
      "Template Method",
      "Composite",
      "Strategy",
      "Registry/Factory",
      "Chain of Responsibility/Pipeline",
      "Observer/Hook",
      "Adapter",
      "Builder",
      "Type Guard (Symbol-based)",
      "AsyncGenerator",
      "Context Object",
      "Delta/Event Sourcing"
    ],
    "devWorkspace": {
      "components": [
        "CLI (web, api_server, create, run, deploy)",
        "Express server",
        "Angular debug UI",
        "AgentLoader"
      ]
    }
  },
  "dependencies": {
    "runtime": {
      "critical": [
        {
          "name": "@google/genai",
          "purpose": "Gemini API client"
        },
        {
          "name": "@modelcontextprotocol/sdk",
          "purpose": "MCP protocol implementation"
        },
        {
          "name": "google-auth-library",
          "purpose": "GCP authentication"
        },
        {
          "name": "zod",
          "purpose": "Schema validation"
        },
        {
          "name": "lodash-es",
          "purpose": "Utility functions"
        }
      ]
    },
    "devDependencies": {
      "tools": [
        {
          "name": "express",
          "purpose": "Web server for dev server"
        },
        {
          "name": "commander",
          "purpose": "CLI argument parsing"
        },
        {
          "name": "esbuild",
          "purpose": "Bundling"
        },
        {
          "name": "@clack/prompts",
          "purpose": "Interactive CLI prompts"
        }
      ]
    },
    "externalServices": [
      {
        "name": "Google AI (Gemini API)",
        "purpose": "LLM inference"
      },
      {
        "name": "Vertex AI",
        "purpose": "Alternative LLM endpoint"
      },
      {
        "name": "Apigee",
        "purpose": "API gateway integration"
      },
      {
        "name": "Google Cloud Storage (GCS)",
        "purpose": "Artifact storage"
      },
      {
        "name": "OpenTelemetry",
        "purpose": "Observability and tracing"
      },
      {
        "name": "MCP servers",
        "purpose": "Tool provider integration"
      }
    ],
    "authentication": {
      "methods": [
        "API key (GOOGLE_API_KEY/GOOGLE_GENAI_API_KEY)",
        "Application Default Credentials (ADC)",
        "Service Account",
        "OAuth2"
      ],
      "environmentVariables": [
        "GOOGLE_API_KEY",
        "GOOGLE_GENAI_API_KEY",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "ADK_LOG_LEVEL"
      ]
    }
  },
  "flows": {
    "mainExecution": {
      "description": "Primary agent execution flow",
      "steps": [
        "Runner.runAsync initiated",
        "Plugin callbacks executed",
        "agent.runAsync invoked",
        "LLM request processors run",
        "LLM API call made",
        "Response processors handle output",
        "Tool execution if applicable",
        "Agent transfer via transfer_to_agent FunctionTool if needed"
      ]
    },
    "eventFlow": {
      "description": "Event creation and persistence",
      "steps": [
        "createEvent() instantiation",
        "Event yielded from generator",
        "Plugin onEventCallback triggered",
        "Event appended to session",
        "State delta applied"
      ]
    },
    "streaming": {
      "description": "Server-Sent Events streaming",
      "endpoint": "POST /run_sse",
      "headers": "SSE headers configured",
      "behavior": "Partial events not persisted to session, only final events saved"
    },
    "agentTransfer": {
      "description": "Transfer control between agents",
      "mechanism": "transfer_to_agent FunctionTool"
    },
    "pluginLifecycle": {
      "description": "Plugin execution hooks",
      "callbackHooks": 14,
      "executionSemantics": "Early-exit semantics",
      "order": "Plugins execute before agent callbacks"
    },
    "mcpIntegration": {
      "description": "Model Context Protocol integration",
      "discovery": "MCPToolset discovers tools via MCP protocol",
      "wrapping": "MCPTool wraps individual tools from MCP servers"
    }
  },
  "api": {
    "restEndpoints": {
      "count": "20+",
      "location": "Dev server",
      "categories": [
        {
          "name": "Sessions",
          "operations": [
            "CRUD operations"
          ]
        },
        {
          "name": "Artifacts",
          "operations": [
            "CRUD operations"
          ]
        },
        {
          "name": "Execution",
          "endpoints": [
            "/run",
            "/run_sse"
          ]
        },
        {
          "name": "Discovery",
          "endpoints": [
            "/list-apps"
          ]
        },
        {
          "name": "Debugging",
          "endpoints": [
            "debug traces",
            "agent graph visualization"
          ]
        }
      ]
    },
    "cliCommands": [
      "web",
      "api_server",
      "create",
      "run",
      "deploy cloud_run"
    ]
  },
  "metadata": {
    "aggregatedAt": "2026-02-20T00:00:00.000Z",
    "discoveryTasks": [
      "1A: Language & Manifests",
      "1B: Components & Architecture",
      "1C: Dependencies & Integration",
      "1D: Flows & APIs"
    ]
  }
}
