{
  "name": "@google/adk-integrations",
  "version": "2.4.0",
  "description": "Google ADK JS Integrations",
  "author": "Google",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/adk-js"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "typings": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/web/index_web.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/web/index_web.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./dist/web/index_web.js": {
      "types": "./dist/types/index_web.d.ts",
      "default": "./dist/web/index_web.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "clean:all": "npm run clean && rm -rf node_modules",
    "rebuild": "npm run clean:all && npm install && npm run build",
    "build": "tsc --emitDeclarationOnly && node ./build.js",
    "build:bundle": "tsc --emitDeclarationOnly && node ./build.js --bundle",
    "build:watch": "concurrently \"tsc --noEmit --watch --preserveWatchOutput\" \"node ./build.js --watch\"",
    "test": "vitest",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google/adk": "^2.4.0",
    "@google/genai": "^2.29.1",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@anthropic-ai/vertex-sdk": "^1.0.0",
    "@google-cloud/bigquery": "^9.2.0",
    "@google-cloud/bigquery-storage": "^6.1.0",
    "@google-cloud/storage": "^7.17.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@anthropic-ai/vertex-sdk": "^1.0.0",
    "@google-cloud/bigquery": "^9.2.0",
    "@google-cloud/bigquery-storage": "^6.1.0",
    "@google-cloud/storage": "^7.17.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@anthropic-ai/vertex-sdk": {
      "optional": true
    },
    "@google-cloud/bigquery": {
      "optional": true
    },
    "@google-cloud/bigquery-storage": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  }
}
