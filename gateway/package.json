{
  "name": "@google/adk-gateway",
  "version": "2.0.0",
  "description": "Google ADK JS Gateway - messenger connectivity for ADK agents",
  "author": "Google",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/adk-js"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "typings": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./telegram": {
      "types": "./dist/types/telegram/index.d.ts",
      "import": "./dist/esm/telegram/index.js",
      "require": "./dist/cjs/telegram/index.js",
      "default": "./dist/esm/telegram/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.js",
      "default": "./dist/esm/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "clean:all": "npm run clean && rm -rf node_modules",
    "rebuild": "npm run clean:all && npm install && npm run build",
    "build": "tsc --emitDeclarationOnly && node ./build.js",
    "build:bundle": "tsc --emitDeclarationOnly && node ./build.js --bundle",
    "build:watch": "concurrently \"tsc --noEmit --watch --preserveWatchOutput\" \"node ./build.js --watch\"",
    "test": "vitest",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google/adk": "^2.0.0"
  },
  "peerDependencies": {
    "express": "^4.22.1 || ^5.1.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
